# Slack Bot Token
# Create at: https://api.slack.com/apps → OAuth & Permissions
# Required scopes: channels:read, channels:history, chat:write, users:read, search:read
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxx-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Slack User Token (for search functionality)
# SLACK_USER_TOKEN=xoxp-xxxxxxxxxxxx-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx
